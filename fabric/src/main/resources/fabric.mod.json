{
  "schemaVersion": 1,
  "id": "ami",
  "version": "${version}",
  "name": "Automated Materials Index",
  "description": "Search, recipe browsing, and content indexing for large modded Minecraft packs.",
  "authors": ["Ashley"],
  "contact": {
    "homepage": "https://github.com/ashleywr/AutomatedMaterialsIndex",
    "sources": "https://github.com/ashleywr/AutomatedMaterialsIndex",
    "issues": "https://github.com/ashleywr/AutomatedMaterialsIndex/issues"
  },
  "license": "MIT",
  "icon": "icon.png",
  "environment": "*",
  "accessWidener": "ami.accesswidener",
  "entrypoints": {
    "main": ["com.sanhiruzu.ami.fabric.AmiFabric"],
    "client": ["com.sanhiruzu.ami.fabric.AmiFabricClient"],
    "jei_mod_plugin": ["com.sanhiruzu.ami.compat.AmiJeiPlugin"],
    "rei_client": ["com.sanhiruzu.ami.fabric.compat.AmiReiPlugin"]
  },
  "mixins": [
    "ami.mixins.json",
    { "config": "ami.client.mixins.json", "environment": "client" }
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "jei": "*",
    "emi": "*",
    "roughlyenoughitems": "*"
  }
}
